# Copy to .env — never point this prototype at live government databases.
DATABASE_URL=postgresql+psycopg://nlamp:nlamp@localhost:5432/nlamp
POSTGRES_USER=nlamp
POSTGRES_PASSWORD=nlamp
POSTGRES_DB=nlamp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT — replace JWT_SECRET_KEY before any non-demo deployment
JWT_SECRET_KEY=nlamp-dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins (Vite default below). Do not set * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# mock | external (external always fails closed — no invented government URLs)
INTEGRATION_MODE=mock
